# Copy to backend/.env and fill in only what you need.
#
# NOTHING HERE IS REQUIRED for crypto backtesting, walk-forward optimization,
# or the Market Lab. Seed the data with `python scripts/seed_data.py` and the
# app runs with no .env at all. Every key below unlocks an optional feature.

# --- Optional: AI features (strategy builder, AI analysis panels) -----------
# Without it, those panels are simply unavailable; everything else works.
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: CME futures data (ES / NQ / CL / GC) -------------------------
# Databento is a paid vendor; their data is licensed per subscriber and is not
# shipped with this repo. With your own key:
#     python scripts/pull_databento.py
# Without it, the futures symbols are unavailable. Crypto is unaffected.
DATABENTO_API_KEY=db-...

# --- Optional: TradeStation broker connection ------------------------------
TRADESTATION_BASE_URL=https://api.tradestation.com/v3
TRADESTATION_REDIRECT_URI=http://localhost:6173/api/tradestation/callback

# --- Optional: Live Terminal positions / risk / reconciliation -------------
# Read-only connection to a local WAMP MySQL database. If it's unreachable the
# Live Terminal falls back to clearly-labeled SIMULATED positions.
WAMP_DB_HOST=localhost
WAMP_DB_USER=root
WAMP_DB_PASS=
WAMP_DB_NAME=sinegu_db

# --- Optional: CORS origins (comma-separated; defaults to *) ---------------
# CORS_ORIGINS=http://localhost:5173
